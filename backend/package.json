{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "devDependencies": {
    "@types/cors": "^2.8.19"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "prisma": "^6.18.0"
  }
}
